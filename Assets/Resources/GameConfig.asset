      - speaker: "\uC11C\uD558"
        text: "\uCCAB\uB0A0\uBD80\uD130 \uC904\uC5C8\uB124\u2026 \uADF8\uB798\uB3C4
          \uB0B4\uC77C \uC544\uCE68 \uADFC\uBB34\uB85C \uB2E4\uC2DC \uC2DC\uC791\uD560
