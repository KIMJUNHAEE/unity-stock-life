      useCharacterLayer: 1
      hint: "\uC9D1 \uC0AC\uC9C4 \uB300\uC2E0 \uACC4\uD68D\uC744 \uC801\uB294 \uBC24"
      conditionText: "\uBC24 \uC885\uB8CC \uC2DC \uC2DC\uC791 \uBD80\uCC44\uB97C
        \uC81C\uC678\uD55C \uC21C\uC790\uAE08 3,000,000\uC6D0 \uC774\uC0C1 (\uC774\uC0AC
        \uBAA9\uD45C \uC784\uC2DC\uAC12)"
      conditions:
        mode: 0
        items:
        - stat: net_financial_assets_excluding_starting_debt
          op: 0
          value: 3000000
      lines:
      - speaker: 
        text: "\uB298 \uC800\uC7A5\uB9CC \uD558\uB358 \uBC29 \uC0AC\uC9C4\uB4E4.
          \uC624\uB298\uC740 \uBA54\uBAA8\uC7A5\uC744 \uC5F0\uB2E4."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uBCF4\uC99D\uAE08, \uC774\uC0AC \uB0A0\uC9DC, \uCC3D\uBB38 \uBC29\uD5A5\u2026
          \uC9C4\uC9DC\uB85C \uC801\uC5B4 \uBCFC\uAE4C."
        expression: happy
        image: {fileID: 0}
    - id: CS_liquidation
      title: "\uD654\uBA74\uC740 \uAEBC\uB3C4 \uD604\uC2E4\uC740 \uB0A8\uB294\uB2E4"
      category: "\uC120\uBB3C"
      priority: 70
