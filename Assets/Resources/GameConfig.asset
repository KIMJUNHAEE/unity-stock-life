      lines:
      - speaker: "\uC11C\uD558"
        text: "\uBCF8\uC804\uC774\uB124. \uC218\uC218\uB8CC\uAC00 \uC0DD\uAC01\uBCF4\uB2E4
          \uD06C\uAD6C\uB098."
        expression: focus
        image: {fileID: 0}
    tutorial:
    - key: stock
      lines:
      - speaker: 
        text: "\uC99D\uAD8C \uC571\uC774\uC57C. \uC67C\uCABD\uC740 \uAD00\uC2EC \uC885\uBAA9,
          \uAC00\uC6B4\uB370\uB294 \uCE94\uB4E4 \uCC28\uD2B8, \uC544\uB798 \uB9C9\uB300\uB294
          \uAC70\uB798\uB7C9\uC774\uC57C."
        expression: normal
        image: {fileID: 0}
      - speaker: 
        text: "\uBE68\uAC04 \uBD09\uC740 \uADF8 \uC2DC\uAC04\uC5D0 \uC62C\uB790\uACE0
          \uD30C\uB780 \uBD09\uC740 \uB0B4\uB838\uB2E4\uB294 \uB73B\uC774\uC57C.
          \uAE30\uD638(\u25B2\u25BC)\uB3C4 \uAC19\uC774 \uBCF4\uC5EC \uC904\uAC8C."
        expression: normal
        image: {fileID: 0}
      - speaker: 
        text: "\uC624\uB978\uCABD\uC5D0\uC11C \uC218\uB7C9\uC744 \uC815\uD558\uACE0
          \uC2DC\uC7A5\uAC00\uB85C \uC0AC\uACE0\uD314 \uC218 \uC788\uC5B4. \uC8FC\uBB38
          \uC804 \uAE08\uC561\uACFC \uC218\uC218\uB8CC\uAC00 \uAC19\uC774 \uBCF4\uC5EC."
        expression: focus
        image: {fileID: 0}
      - speaker: 
        text: "\uC774 \uCC3D\uC774 \uC55E\uC5D0 \uC788\uC744 \uB54C\uB9CC \uC2DC\uC7A5
          \uC2DC\uAC04\uC774 \uD758\uB7EC. \uBE0C\uB77C\uC6B0\uC800\uB098 \uBA54\uB274\uB97C
          \uC5F4\uBA74 \uBAA8\uB4E0 \uC885\uBAA9\uC774 \uD568\uAED8 \uBA48\uCDB0."
        expression: normal
        image: {fileID: 0}
      - speaker: 
        text: "\uC5B4\uB5A4 \uCC28\uD2B8 \uBAA8\uC591\uB3C4 \uC218\uC775\uC744 \uBCF4\uC7A5\uD558\uC9C4
          \uC54A\uC544. \uD310\uB2E8\uC740 \uB124 \uBAAB\uC774\uC57C."
        expression: focus
        image: {fileID: 0}
    - key: browser
      lines:
      - speaker: 
        text: "\uB274\uC2A4 \uC0AC\uC774\uD2B8\uC640 \uCEE4\uBBA4\uB2C8\uD2F0 \uC0AC\uC774\uD2B8\uAC00
          \uC788\uC5B4. \uB458 \uB2E4 \uAC8C\uC784 \uC18D \uAC00\uC0C1 \uC0AC\uC774\uD2B8\uC57C."
        expression: normal
        image: {fileID: 0}
      - speaker: 
        text: "\uB274\uC2A4\uB294 \uD655\uC778\uB41C \uC0AC\uC2E4\uC774\uC9C0\uB9CC,
          \uAC00\uACA9\uC5D4 \uC774\uBBF8 \uBC18\uC601\uB410\uC744 \uC218\uB3C4 \uC788\uC5B4.
          \uAE30\uC0AC \uC2DC\uAC01\uACFC \uCC28\uD2B8\uB97C \uAC19\uC774 \uBD10."
        expression: focus
        image: {fileID: 0}
      - speaker: 
        text: "\uCEE4\uBBA4\uB2C8\uD2F0 \uAE00\uC740 \uBE60\uB974\uC9C0\uB9CC \uD2C0\uB9B4
          \uC218 \uC788\uC5B4. \uCD94\uCC9C \uC218\uB098 \uB9D0\uD22C\uAC00 \uC9C4\uC2E4\uC744
          \uC54C\uB824 \uC8FC\uC9C4 \uC54A\uC544."
        expression: normal
        image: {fileID: 0}
    intro:
      id: INTRO
      title: "\uB450\uADFC\uB450\uADFC \uD2B8\uB808\uC774\uB529"
      category: "\uAE30\uD0C0"
      priority: 0
      repeatable: 1
      enabled: 1
      countsForCollection: 1
      secret: 0
      image: {fileID: 21300000, guid: 3f9a104ae67d45640b8d6cb042dffcd0, type: 3}
      useCharacterLayer: 1
      hint: 
      conditionText: 
      conditions:
        mode: 0
        items: []
      lines:
      - speaker: 
        text: "\uC0C8\uBCBD \uC54C\uB78C. \uC791\uC740 \uBC29, \uC791\uC740 \uB0C9\uC7A5\uACE0,
          \uC758\uC790\uC5D0 \uAC78\uB9B0 \uD3B8\uC758\uC810 \uADFC\uBB34\uBCF5."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\u2026\uC77C\uC5B4\uB098\uC790."
        expression: tired
        image: {fileID: 0}
      - speaker: 
        text: "\uCC45\uC0C1 \uC704 \uC0C1\uD658 \uC548\uB0B4\uC11C. \uB0A8\uC740
          \uAE08\uC561 1,000,000,000\uC6D0."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uC624\uB298\uB3C4 \uBD84\uBA85 \uC77C\uD560 \uAC74\uB370. \uC65C
          \uD558\uB098\uB3C4 \uAC00\uAE4C\uC6CC\uC9C0\uB294 \uAC83 \uAC19\uC9C0\uAC00
          \uC54A\uC9C0."
        expression: sad
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\u2026\uC77C\uB2E8 \uCD9C\uADFC. \uBC24\uC5D0\uB294 \uADF8 \uC571,
          \uD55C\uBC88 \uC5F4\uC5B4 \uBCF4\uC790."
        expression: normal
        image: {fileID: 0}
    system:
      marketNote: "\uBAA8\uB4E0 \uC885\uBAA9\uC758 \uC2DC\uC7A5 \uC2DC\uAC04\uC774
        \uD568\uAED8 \uD750\uB985\uB2C8\uB2E4. \uB2E4\uB978 \uC571\uC774\uB098 \uBA54\uB274\uB97C
        \uC5F4\uBA74 \uC2DC\uC7A5\uC774 \uBA48\uCDA5\uB2C8\uB2E4. (Space: \uC77C\uC2DC\uC815\uC9C0)"
      blinkWarning: "\uC878\uC74C \uB2E8\uACC4: \uAC00\uB054 \uB208\uC774 \uAC10\uACA8
        \uCC28\uD2B8\uB97C \uC7A0\uAE50 \uB193\uCE60 \uC218 \uC788\uC5B4\uC694. \uC8FC\uBB38\xB7\uD604\uAE08\xB7\uD604\uC7AC\uAC00\uB294
        \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4."
      browserHint: "\uB274\uC2A4\uB294 \uD655\uC778\uB41C \uC0AC\uC2E4\uC774\uC9C0\uB9CC
        \uAC00\uACA9\uC5D0 \uBA3C\uC800 \uBC18\uC601\uB410\uC744 \uC218 \uC788\uACE0,
        \uCEE4\uBBA4\uB2C8\uD2F0 \uAE00\uC740 \uBE60\uB974\uC9C0\uB9CC \uD2C0\uB9B4
        \uC218 \uC788\uC5B4\uC694. \uAC8C\uC2DC \uC2DC\uAC01\uACFC \uCC28\uD2B8\uB97C
        \uD568\uAED8 \uBCF4\uC138\uC694."
      startingDebtTitle: "\uBD80\uBAA8\uB2D8\uC774 \uB0A8\uAE34 \uBE5A"
      startingDebtNote: "\uC2DC\uC791 \uBD80\uCC44\uB294 \uC7A5\uAE30 \uBAA9\uD45C\uC785\uB2C8\uB2E4.
        \uC2DC\uC81C\uD488\uC5D0\uC11C\uB294 \uC774\uC790\uB098 \uAC15\uC81C \uAE30\uD55C
        \uC5C6\uC774 \uC6D0\uD560 \uB54C \uC6D0\uAE08\uB9CC \uAC1A\uC744 \uC218 \uC788\uC5B4\uC694."
      storyPlaceholder: "\uBCF8\uD3B8 \uC7A5\uBA74\uC740 \uC544\uC9C1 \uC791\uC131
        \uC804\uC785\uB2C8\uB2E4. \uC120\uD0DD\uC740 \uC774\uBC88 \uD68C\uCC28\uC5D0
        \uAE30\uB85D\uB429\uB2C8\uB2E4."
