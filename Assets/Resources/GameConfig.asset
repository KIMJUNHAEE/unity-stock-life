      useCharacterLayer: 0
      hint: "\uC120\uBB3C \uAC70\uB798 \uB3C4\uC785 \uD6C4"
      conditionText: "\uCCAB \uC120\uBB3C \uAC15\uC81C \uCCAD\uC0B0 (\uC120\uBB3C
        \uC2DC\uC2A4\uD15C \uB3C4\uC785 \uC804\uC774\uB77C \uBE44\uD65C\uC131)"
      conditions:
        mode: 0
        items:
        - stat: forced_liquidations_today
          op: 0
          value: 1
      lines:
      - speaker: 
        text: "\uB178\uD2B8\uBD81\uC744 \uCC9C\uCC9C\uD788 \uB2EB\uC558\uB2E4\uAC00,
          \uB2E4\uC2DC \uC5F0\uB2E4. \uC794\uC561\uC740 \uADF8\uB300\uB85C\uB2E4."
        expression: 
        image: {fileID: 0}
    - id: CS_daily_first_night
      title: "\uCCAB\uB0A0\uC758 \uB05D"
      category: "\uC77C\uC0C1"
      priority: 40
      repeatable: 0
      enabled: 1
      countsForCollection: 1
      secret: 0
      image: {fileID: 21300000, guid: 3f9a104ae67d45640b8d6cb042dffcd0, type: 3}
      useCharacterLayer: 1
      hint: "\uCC98\uC74C\uC73C\uB85C \uD558\uB8E8\uB97C \uB9C8\uCE5C \uBC24"
      conditionText: "\uCCAB \uACB0\uC0B0\uC744 \uB9C8\uCE5C \uBC24 (\uD22C\uC790
        \uACB0\uACFC\uC640 \uC0C1\uAD00\uC5C6\uC74C)"
      conditions:
        mode: 0
        items:
        - stat: nights_played
          op: 4
          value: 1
      lines:
      - speaker: "\uC11C\uD558"
        text: "\uCCAB\uB0A0\uC774 \uB05D\uB0AC\uB2E4. \uC54C\uBC14\uD558\uACE0, \uCC28\uD2B8
          \uBCF4\uACE0\u2026 \uC0DD\uAC01\uBCF4\uB2E4 \uD558\uB8E8\uAC00 \uAE38\uC5C8\uC5B4."
        expression: tired
        image: {fileID: 0}
      - speaker: 
        text: "\uCC45\uC0C1 \uC704\uC5D0\uB294 \uC624\uB298 \uBC1B\uC740 \uC601\uC218\uC99D\uACFC,
          \uC544\uC9C1 \uADF8\uB300\uB85C\uC778 10\uC5B5\uC774\uB77C\uB294 \uC22B\uC790."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uC22B\uC790\uB294 \uADF8\uB300\uB85C\uC778\uB370, \uC624\uB298 \uD55C
          \uC77C\uC740 \uD558\uB098\uC529 \uB0A8\uC544 \uC788\uB124."
        expression: normal
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uBB34\uC5C7\uC744 \uBD24\uB294\uC9C0, \uC65C \uADF8\uB807\uAC8C \uD588\uB294\uC9C0.
          \uB0B4\uC77C\uC740 \uADF8\uAC78 \uAE30\uC5B5\uD558\uBA74\uC11C \uD574 \uBCF4\uC790."
        expression: focus
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\u2026\uC77C\uB2E8 \uC53B\uACE0 \uC790\uC790. \uB0B4\uC77C\uB3C4,
          \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4."
        expression: happy
        image: {fileID: 0}
    - id: MT_manager_first_visit
      title: "\uC810\uC7A5\uB2D8\uC758 \uC544\uCE68"
      category: "\uB9CC\uB0A8"
      priority: 0
      repeatable: 0
      enabled: 1
      countsForCollection: 1
      secret: 0
      image: {fileID: 21300000, guid: 624c78ca1bc51d243ad97a680c012020, type: 3}
      useCharacterLayer: 0
      hint: "\uADFC\uBB34 \uC5C6\uB294 \uC544\uCE68, \uD3B8\uC758\uC810 \uC55E\uC5D0\uC11C"
      conditionText: "3\uC77C\uCC28 \uC774\uD6C4 \uC544\uCE68\uC5D0 \uCD9C\uADFC
        \uB300\uC2E0 \uB9CC\uB0A8\uC744 \uACE0\uB974\uBA74"
      conditions:
        mode: 0
        items: []
      lines:
      - speaker: 
        text: "\uADFC\uBB34\uAC00 \uC5C6\uB294 \uC544\uCE68. \uD3B8\uC758\uC810 \uC55E\uC744
          \uC9C0\uB098\uB294\uB370 \uC720\uB9AC\uBB38\uC774 \uC5F4\uB9B0\uB2E4."
        expression: 
        image: {fileID: 0}
      - speaker: "\uBB38\uCC44\uB9B0"
        text: "\uC11C\uD558 \uC528, \uC624\uB298 \uC26C\uB294 \uB0A0\uC774\uC8E0?
          \uC5BC\uAD74 \uBCF4\uB7EC \uC7A0\uAE50 \uB098\uC654\uC5B4\uC694."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uC810\uC7A5\uB2D8\u2026 \uB124, \uC624\uB298\uC740 \uCD9C\uADFC \uC548
          \uD558\uB294 \uB0A0\uC774\uB77C\uC11C\uC694."
        expression: surprised
        image: {fileID: 0}
      - speaker: "\uBB38\uCC44\uB9B0"
        text: "\uC694\uC998 \uBC24\uC5D0 \uBB58 \uADF8\uB807\uAC8C \uC5F4\uC2EC\uD788
          \uBD10\uC694? \uCD9C\uADFC\uD560 \uB54C\uB9C8\uB2E4 \uB208\uC774 \uBE68\uAC1C\uC694."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\uC544, \uADF8\uAC8C\u2026 \uACF5\uBD80 \uBE44\uC2B7\uD55C \uAC70\uC608\uC694."
        expression: tired
        image: {fileID: 0}
      - speaker: "\uBB38\uCC44\uB9B0"
        text: "\uBB58 \uD558\uB4E0 \uBC25\uC740 \uCC59\uACA8 \uBA39\uC5B4\uC694.
          \uB07C\uB2C8 \uAC70\uB974\uBA74 \uACC4\uC0B0\uB3C4 \uD2C0\uB824\uC694.
          \uAC00\uAC8C\uC5D0\uC11C\uB3C4, \uB2E4\uB978 \uB370\uC11C\uB3C4."
        expression: 
        image: {fileID: 0}
      - speaker: "\uC11C\uD558"
        text: "\u2026\uB124. \uBA85\uC2EC\uD560\uAC8C\uC694."
        expression: happy
        image: {fileID: 0}
      - speaker: "\uBB38\uCC44\uB9B0"
        text: "\uB2E4\uC74C \uADFC\uBB34 \uB54C \uBD10\uC694. \uB2A6\uC9C0 \uB9D0\uACE0."
        expression: 
        image: {fileID: 0}
